# ── App ────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
PORT=5001

# ── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/oauth/callback

# ── Email sending ───────────────────────────────────────────
# Option 1 (recommended): Resend API — works on all hosts including Render free
# Get your key at resend.com → free tier: 3,000 emails/month
# When set, SMTP credentials in Settings are used only for From/Name/Reply-To
RESEND_API_KEY=re_...

# Option 2: leave RESEND_API_KEY blank to fall back to direct SMTP
# (requires paid Render plan or running locally)

# ── AI Research (server-side — users don't need this) ───────
OPENAI_API_KEY=sk-...
